{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuayue.example/schemas/packs/v1/pack.schema.json",
  "title": "KuaYue external pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "id", "version", "namespaces", "name_key", "dependencies", "parcels"],
  "properties": {
    "format_version": {"const": 1},
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "not": {"const": "kuayue-core"}
    },
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_.-]+$"}
    },
    "name_key": {"type": "string", "minLength": 1},
    "description_key": {"type": "string", "minLength": 1},
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mods", "packs"],
      "properties": {
        "mods": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minecraft", "neoforge", "kuayue", "kasuga_lib", "create"],
          "properties": {
            "minecraft": {"$ref": "#/$defs/versionRange"},
            "neoforge": {"$ref": "#/$defs/versionRange"},
            "kuayue": {"$ref": "#/$defs/versionRange"},
            "kasuga_lib": {"$ref": "#/$defs/versionRange"},
            "create": {"$ref": "#/$defs/versionRange"}
          }
        },
        "packs": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
          "additionalProperties": {"$ref": "#/$defs/versionRange"}
        }
      }
    },
    "parcels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^parcels/[a-z0-9_.-]+/parcel\\.json$"}
    },
    "save_compatibility": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from_versions"],
          "properties": {
            "from_versions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/semver"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_version"],
          "properties": {
            "minimum_version": {"$ref": "#/$defs/semver"}
          }
        }
      ]
    }
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "versionRange": {
      "type": "string",
      "pattern": "^(\\*|(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)|\\[(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*),(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\))$"
    }
  }
}
