{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuayue.example/schemas/data-driven/v1/bogeys.schema.json",
  "title": "转向架复合内容文件",
  "description": "转向架复合内容文件，可按阶段组合 sizes、motions、models、blocks、styles 与跨包 style variants。",
  "type": "object",
  "properties": {
    "bogey_sizes": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/bogeySize"
      }
    },
    "bogey_blocks": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/bogeyBlock"
      }
    },
    "bogey_motions": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/bogeyMotion"
      }
    },
    "bogey_models": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/bogeyModel"
      }
    },
    "bogey_styles": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/bogeyStyle"
      }
    },
    "bogey_style_variants": {
      "type": "array",
      "items": {
        "$ref": "content.schema.json#/$defs/bogeyStyleContribution"
      }
    }
  },
  "additionalProperties": false,
  "minProperties": 1
}
